{
  "name": "lovely-kids-api",
  "keep_vars": true,
  "routes": [
    {
      "pattern": "api.lovelykids.net",
      "custom_domain": true
    }
  ],
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "15 2 * * *"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "165581b7907f47b6884b71e02abab3c7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "lovely-kids-media-r2"
    }
  ],
  "cache": {
    "enabled": false
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": {
        "enabled": false
      }
    },
    "PublicAPI": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    }
  },
  "vars": {
    "IMAGE_STORAGE_PROVIDER": "supabase",
    "POS_PURCHASE_API_ENABLED": "true",
    "POS_PURCHASE_WRITES_ENABLED": "true",
    "META_FACEBOOK_PAGE_ID": "400159390780629",
    "META_FACEBOOK_POSTS_USE_NEXT_TOKEN": "true",
    "META_FACEBOOK_STORIES_NEXT_PILOT_ENABLED": "true",
    "META_INSTAGRAM_ACCOUNT_ID": "17841411928735926",
    "META_INSTAGRAM_FEED_USE_NEXT_TOKEN": "true",
    "META_INSTAGRAM_STORIES_USE_NEXT_TOKEN": "false",
    "META_INSTAGRAM_STORIES_NEXT_PILOT_ENABLED": "true",
    "META_INSTAGRAM_CAROUSEL_ENABLED": "true"
  },
  "workers_dev": true,
  "preview_urls": true
}
